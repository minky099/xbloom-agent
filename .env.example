# Copy to .env and fill in before running `docker compose up`.

# Supabase project that holds the encrypted `user_sessions` table.
# Service role key is required — the server writes sessions server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL this server is reachable at (used for OAuth discovery metadata).
# Set this to your own domain when self-hosting, e.g. https://mcp.example.com
# Leave blank to use the hosted Supabase default.
MCP_BASE_URL=
