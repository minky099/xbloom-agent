# Copy to .env and fill in before running `docker compose up`.

# Required: secret used to encrypt stored XBloom sessions at rest.
# Use a long random string — generate one with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: public URL this server is reachable at (OAuth discovery metadata).
# Set to your own domain when self-hosting, e.g. https://mcp.example.com
# Leave blank for local use.
MCP_BASE_URL=
